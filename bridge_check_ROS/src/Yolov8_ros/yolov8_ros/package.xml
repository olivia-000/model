<?xml version="1.0"?>
<package format="2">
  <name>yolov8_ros</name>
  <version>1.0.0</version>
  <description>Unified multi-camera bridge + road damage detection node for ROS1 Noetic</description>

  <maintainer email="itri@itri.org.tw">ITRI</maintainer>
  <license>APLv2</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>rospy</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>message_filters</build_depend>
  <build_depend>cv_bridge</build_depend>
  <build_depend>yolov8_ros_msgs</build_depend>
  <build_depend>yolov8_ros_box_image_msgs</build_depend>

  <build_export_depend>rospy</build_export_depend>
  <build_export_depend>std_msgs</build_export_depend>
  <build_export_depend>sensor_msgs</build_export_depend>
  <build_export_depend>message_filters</build_export_depend>
  <build_export_depend>cv_bridge</build_export_depend>
  <build_export_depend>yolov8_ros_msgs</build_export_depend>
  <build_export_depend>yolov8_ros_box_image_msgs</build_export_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>yolov8_ros_msgs</exec_depend>
  <exec_depend>yolov8_ros_box_image_msgs</exec_depend>

  <export>
  </export>
</package>
